    {
      "id": "4f36eb84-522e-4c47-8ce8-dc279065e2d4",
      "name": "Build Dashboard Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Returns both tabs as plain JSON. Empty tabs come through as one empty item, so filter them out.\nconst rows = (node) => $(node).all().map((i) => i.json).filter((r) => r && r['Campaign ID']);\nreturn [{ json: { generated_at: $now.toISO(), campaigns: rows('Read Campaigns'), log: rows('Read Status Log') } }];"
      }
    },
    {
      "id": "4bb4f038-5591-427c-a8f3-092bd3071599",
      "name": "Send Dashboard Data",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    },
    {
      "id": "9f69a2cd-1c90-487d-9517-396cf1b09dc2",
      "name": "Note API",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        100
      ],
      "parameters": {
        "content": "## Dashboard Data API (read-only)\nThe dashboard calls GET /webhook/campaign-dashboard-data. This workflow reads the **Campaigns** and **Status Log** tabs and returns them as JSON. It never writes anything.",
        "width": 1120,
        "height": 400,
        "color": 4
      }
    }
  ],
